</div>

<!-- About Page -->
<div id="about-page" class="page-content d-none">
	<div class="page-header">
		<div class="container">
			<h1><i class="fas fa-users me-3"></i>О нас</h1>
			<p>Узнайте больше о нашей компании и миссии</p>
		</div>
	</div>
	<section id="about" class="container py-5">
		<div class="row align-items-center mb-5">
			<div class="col-lg-6" data-aos="fade-right">
				<h2>Наша история</h2>
				<p class="lead">
					PaperCraft начал свою деятельность в 2010 году как небольшой
					семейный магазин канцелярских товаров.
				</p>
				<p>
					За годы работы мы выросли в одну из ведущих компаний в области
					поставки качественных канцелярских принадлежностей. Наша миссия -
					предоставить каждому клиенту доступ к лучшим товарам для
					творчества, учебы и работы.
				</p>
				<p>
					Мы сотрудничаем с ведущими производителями со всего мира и
					гордимся тем, что можем предложить нашим клиентам только
					качественную и проверенную продукцию.
				</p>
			</div>
			<div class="col-lg-6" data-aos="fade-left">
				<div class="text-center">
					<i class="fas fa-store"
					   style="
									font-size: 12rem;
									color: var(--primary-color);
									opacity: 0.3;
								"></i>
				</div>
			</div>
		</div>
		<div class="row">
			<div class="col-md-3 text-center mb-4" data-aos="fade-up">
				<div class="display-4 text-primary fw-bold">13</div>
				<p>лет на рынке</p>
			</div>
			<div class="col-md-3 text-center mb-4"
				 data-aos="fade-up"
				 data-aos-delay="100">
				<div class="display-4 text-primary fw-bold">50K+</div>
				<p>довольных клиентов</p>
			</div>
			<div class="col-md-3 text-center mb-4"
				 data-aos="fade-up"
				 data-aos-delay="200">
				<div class="display-4 text-primary fw-bold">5K+</div>
				<p>товаров в ассортименте</p>
			</div>
			<div class="col-md-3 text-center mb-4"
				 data-aos="fade-up"
				 data-aos-delay="300">
				<div class="display-4 text-primary fw-bold">100+</div>
				<p>брендов-партнеров</p>
			</div>
		</div>
	</section>
</div>

