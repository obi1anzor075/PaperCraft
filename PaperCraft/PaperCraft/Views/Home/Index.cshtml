<!-- Profile Page -->
<div id="profile-page" class="page-content" style="background: linear-gradient(135deg, #6366f1, #8b5cf6);">


	<!-- Hero Section -->
	<section class="profile-hero py-5 position-relative">
		<div class="container text-center">
			<!-- Animated background circles -->
			<div class="bg-circle circle-1"></div>
			<div class="bg-circle circle-2"></div>

			<!-- Avatar -->
			<div class="avatar-container mb-4" data-aos="zoom-in">
				<div class="avatar rounded-circle d-flex align-items-center justify-content-center">
					<i class="fas fa-user-circle"></i>
				</div>
				<div class="avatar-badge rounded-circle"></div>
			</div>

			<h1 class="display-4 fw-bold text-white" data-aos="fade-up" data-aos-delay="200">
				<i class="fas fa-user-edit me-3"></i>Мой профиль
			</h1>
			<p class="lead text-white-75 mb-4" data-aos="fade-up" data-aos-delay="300">
				Управляйте своей учетной записью и персональными данными
			</p>

			<!-- Stats -->
			<div class="stats-grid pt-4" data-aos="fade-up" data-aos-delay="400">
				<div class="stat-card">
					<div class="number" id="stat-orders">0</div>
					<div class="label">Заказов</div>
				</div>
				<div class="stat-card">
					<div class="number" id="stat-years">0</div>
					<div class="label">Года с нами</div>
				</div>
				<div class="stat-card">
					<div class="number" id="stat-rating">★ 4.0</div>
					<div class="label">Рейтинг</div>
				</div>
				<div class="stat-card">
					<div class="number" id="stat-bonus">0</div>
					<div class="label">Бонусов</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Main Content -->
	<div class="profile-content container py-5">
		<div class="row g-4">
			<!-- Profile Form -->
			<div class="col-lg-8">
				<div class="glass-card rounded-4 p-4 profile-form-container" data-aos="fade-right">
					<h3 class="fw-bold mb-4 text-dark">Личная информация</h3>
					<form id="profile-form" class="profile-form">
						<div class="row g-3">
							<div class="col-md-6">
								<label for="profile-firstName" class="text-dark">Имя *</label>
								<input type="text" id="profile-firstName" class="form-control" placeholder="Имя">
							</div>
							<div class="col-md-6">
								<label for="profile-lastName" class="text-dark">Фамилия *</label>
								<input type="text" id="profile-lastName" class="form-control" placeholder="Фамилия">
							</div>
							<div class="col-md-6">
								<label for="profile-email" class="text-dark">Email *</label>
								<input type="email" id="profile-email" class="form-control" placeholder="Email">
							</div>
							<div class="col-md-6">
								<label for="profile-phone" class="text-dark">Телефон</label>
								<input type="tel" id="profile-phone" class="form-control" placeholder="Телефон">
							</div>
							<div class="col-12">
								<label for="profile-bio" class="text-dark">О себе</label>
								<textarea id="profile-bio" class="form-control" rows="4" placeholder="О себе"></textarea>
							</div>
						</div>
						<div class="actions d-flex justify-content-end gap-3 mt-4">
							<button type="button" class="btn btn-outline-dark">Отменить</button>
							<button type="button" class="btn btn-primary" id="profile-save-btn">Сохранить изменения</button>
						</div>
					</form>
				</div>

				<!-- Orders Section -->
				<div class="glass-card rounded-4 p-4 mt-4" data-aos="fade-right" data-aos-delay="200">
					<h3 class="fw-bold mb-4 text-dark">Мои заказы</h3>
					<div id="orders-container" class="text-dark">
						<!-- Заказы загружаются JS -->
					</div>
					<!-- Pagination Nav -->
					<nav id="orders-pagination" class="mt-3 d-none">
						<ul class="pagination pagination-custom justify-content-center"></ul>
					</nav>
					<div class="mt-3 text-end">
						<button class="btn btn-outline-dark" onclick="refreshOrders()">
							<i class="fas fa-sync-alt"></i> Обновить
						</button>
					</div>
				</div>
			</div>

			<!-- Sidebar -->
			<div class="col-lg-4">
				<!-- Security -->
				<div class="sidebar-card mb-4 p-4" data-aos="fade-left">
					<h5 class="fw-bold mb-3 text-dark">Безопасность</h5>
					<div class="d-grid gap-2">
						<button class="btn btn-outline-dark" onclick="showChangePassword()">Изменить пароль</button>
						<button class="btn btn-outline-dark" onclick="exportUserData()">Экспорт данных</button>
					</div>
				</div>

				<!-- Activity Timeline -->
				<div class="sidebar-card mb-4 p-4" data-aos="fade-left" data-aos-delay="200">
					<h5 class="fw-bold mb-3 text-dark">Последняя активность</h5>
					<div id="activity-timeline" class="text-dark">
						<!-- Активность загружается JS -->
					</div>
				</div>

				<!-- Quick Actions -->
				<div class="sidebar-card p-4" data-aos="fade-left" data-aos-delay="300">
					<h5 class="fw-bold mb-3 text-dark">Быстрые действия</h5>
					<div class="d-grid gap-2">
						<button class="btn btn-outline-dark d-flex align-items-center btn-favorite-sidebar">
							<i class="fas fa-heart me-2"></i> Избранное
						</button>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>


