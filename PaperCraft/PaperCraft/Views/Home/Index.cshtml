<!-- Products Page -->
<div id="products-page" class="page-content d-none">
	<div class="page-header position-relative text-center text-white py-5 overflow-hidden">
		<div class="wave wave-top"></div>
		<div class="container position-relative">
			<h1 class="display-4 fw-bold" data-aos="fade-down">Наши товары</h1>
			<p class="lead" data-aos="fade-up" data-aos-delay="200">
				Широкий ассортимент канцелярских товаров высочайшего качества
			</p>
		</div>
		<div class="wave wave-bottom"></div>
	</div>

	<section id="products" class="container py-5">
		<div class="row mb-5 g-3">
			<div class="col-md-4" data-aos="fade-right">
				<div class="input-group shadow-sm rounded">
					<span class="input-group-text bg-white border-0"><i class="fas fa-search"></i></span>
					<input type="text" class="form-control border-0" placeholder="Поиск товаров..." id="search-input">
