@model PaperCraft.ViewModels.PlaceOrderViewModel

<div class="modal-header">
    <h5 class="modal-title"><i class="fas fa-shopping-cart me-2"></i>Оформление заказа</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
</div>
<div class="modal-body">
    <div id="cart-items-list" class="mb-3">
        @foreach (var item in Model.Items)
        {
            <div class="d-flex justify-content-between mb-2">
                <div>@item.ProductId × @item.Quantity</div>
                <div>@item.Price.ToString("C")</div>
            </div>
        }
    </div>
    <div class="mb-3">
        <label for="shippingAddress" class="form-label">Адрес доставки</label>
        <textarea id="shippingAddress" class="form-control" rows="2">@Model.ShippingAddress</textarea>
    </div>
</div>
<div class="modal-footer">
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
    <button type="button" class="btn btn-primary" onclick="placeOrder()">Оформить заказ</button>
</div>
