<!-- _RegisterPartial.cshtml -->
@model PaperCraft.ViewModels.RegisterViewModel

<div class="modal-header bg-primary text-white border-0">
    <h5 class="modal-title">
        <i class="fas fa-user-plus me-2"></i>Регистрация
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
</div>
<div class="modal-body p-4">
    <form id="register-form" asp-controller="Account" asp-action="Register" data-ajax="true" data-ajax-method="POST" data-ajax-success="onRegisterSuccess" data-ajax-failure="onFailure">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label">Имя</label>
                <input asp-for="FirstName" class="form-control form-control-lg" placeholder="Введите имя" />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label">Фамилия</label>
                <input asp-for="LastName" class="form-control form-control-lg" placeholder="Введите фамилию" />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email</label>
            <input asp-for="Email" class="form-control form-control-lg" placeholder="example@mail.com" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="PhoneNumber" class="form-label">Телефон</label>
            <input asp-for="PhoneNumber" class="form-control form-control-lg" placeholder="+7 (___) ___-__-__" />
            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">Пароль</label>
            <input asp-for="Password" class="form-control form-control-lg" placeholder="Минимум 6 символов" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="ConfirmPassword" class="form-label">Подтвердите пароль</label>
            <input asp-for="ConfirmPassword" class="form-control form-control-lg" placeholder="Повторите пароль" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <div class="form-check mb-4">
            <input type="checkbox" class="form-check-input" id="agree-terms" required />
            <label class="form-check-label small" for="agree-terms">
                Я согласен с <a href="#" class="text-decoration-none">условиями использования</a>
            </label>
        </div>
        <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">
            <i class="fas fa-user-plus me-2"></i>Зарегистрироваться
        </button>
    </form>
</div>
<div class="modal-footer justify-content-center border-0 pb-4">
    <small class="text-muted">Уже есть аккаунт? <a href="#" onclick="showLogin()" class="text-decoration-none fw-semibold">Войти</a></small>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}