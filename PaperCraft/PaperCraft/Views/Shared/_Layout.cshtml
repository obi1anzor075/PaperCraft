<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PaperCraft</title>
    <link href="~/css/main.css" rel="stylesheet" />
    <link href="~/css/profile.css" rel="stylesheet" />
    <link href="~/css/animations.css" rel="stylesheet" />
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css"
    rel="stylesheet"
    integrity="sha384-4Q6Gf2aSP4eDXB8Miphtr37CMZZQ5oXLH2yaXMJ2w8e2ZtHTl7GptT4jmndRuHDT"
    crossorigin="anonymous" />

    <!-- Font Awesome -->
    <link rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <!-- AOS Animation Library -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.css"
    rel="stylesheet" />
</head>
<body>
    <!-- Toast Container -->
    <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#home" onclick="showPage('home')">
                <i class="fas fa-palette me-2"></i>PaperCraft
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link active" href="#home" onclick="showPage('home')">Главная</a></li>
                    <li class="nav-item"><a class="nav-link" href="#products" onclick="showPage('products')">Товары</a></li>
                    <li class="nav-item"><a class="nav-link" href="#categories" onclick="showPage('categories')">Категории</a></li>
                    <li class="nav-item"><a class="nav-link" href="#about" onclick="showPage('about')">О нас</a></li>
                    <li class="nav-item"><a class="nav-link" href="#contact" onclick="showPage('contact')">Контакты</a></li>
                </ul>

                <div class="d-flex gap-2">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <button class="btn btn-outline-light" onclick="showPage('profile')">
                            <i class="fas fa-user me-1"></i>Мой профиль
                        </button>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-light">
                                <i class="fas fa-sign-out-alt me-1"></i>Выйти
                            </button>
                        </form>
                    }
                    else
                    {
                        <button class="btn btn-outline-light" onclick="showLogin()">Вход</button>
                        <button class="btn btn-outline-light" onclick="showRegister()">Регистрация</button>
                    }
                    @if (User.Identity.IsAuthenticated)
                    {
                        <button class="btn btn-cart" onclick="showCartModal()">
                            <i class="fas fa-shopping-cart me-1"></i>
                            Корзина
                        </button>
                    }
                </div>
            </div>
        </div>
    </nav>

    @RenderBody()

    <footer class="footer bg-dark text-white py-4">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5><i class="fas fa-pen-fancy me-2"></i>PaperCraft</h5>
                    <p>Ваш надежный партнер в мире канцелярских товаров. Качество, которому можно доверять.</p>
                    <div>
                        <a href="#" class="text-white me-3"><i class="fab fa-vk fa-lg"></i></a>
                        <a href="#" class="text-white me-3"><i class="fab fa-telegram fa-lg"></i></a>
                        <a href="#" class="text-white"><i class="fab fa-instagram fa-lg"></i></a>
                    </div>
                </div>
                <div class="col-md-2 mb-3">
                    <h6>Компания</h6>
                    <ul class="list-unstyled">
                        <li><a href="#about" class="text-white">О нас</a></li>
                        <li><a href="#contact" class="text-white">Контакты</a></li>
                        <li><a href="#" class="text-white">Вакансии</a></li>
                        <li><a href="#" class="text-white">Новости</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-3">
                    <h6>Покупателям</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white">Доставка</a></li>
                        <li><a href="#" class="text-white">Оплата</a></li>
                        <li><a href="#" class="text-white">Возврат</a></li>
                        <li><a href="#" class="text-white">FAQ</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-3">
                    <h6>Категории</h6>
                    <ul class="list-unstyled">
                        <li><a href="#" class="text-white">Ручки</a></li>
                        <li><a href="#" class="text-white">Тетради</a></li>
                        <li><a href="#" class="text-white">Творчество</a></li>
                        <li><a href="#" class="text-white">Офис</a></li>
                    </ul>
                </div>
                <div class="col-md-2 mb-3">
                    <h6>Контакты</h6>
                    <ul class="list-unstyled">
                        <li><i class="fas fa-phone me-1"></i>+7 (495) 123-45-67</li>
                        <li><i class="fas fa-envelope me-1"></i>info@papercraft.ru</li>
                        <li><i class="fas fa-map-marker-alt me-1"></i>г. Москва</li>
                    </ul>
                </div>
            </div>
            <hr class="border-light" />
            <div class="d-flex justify-content-between">
                <small>© 2024 PaperCraft. Все права защищены.</small>
                <div>
                    <a href="#" class="text-white me-3">Политика конфиденциальности</a>
                    <a href="#" class="text-white">Условия использования</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Модалки подгружаются через site.js -->
    <div class="modal fade" id="loginModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"></div></div></div>
    <div class="modal fade" id="registerModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"></div></div></div>
    <div class="modal fade" id="changePasswordModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"></div></div></div>
    <div class="modal fade" id="checkoutModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content" id="checkoutModalContent"></div></div></div>
    <div class="modal fade" id="myOrdersModal" tabindex="-1"><div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content" id="myOrdersModalContent"></div></div></div>
    <div class="modal fade" id="favoritesModal" tabindex="-1" aria-hidden="true"><div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content"><div class="modal-header"><h5 class="modal-title"><i class="fas fa-heart me-2 text-danger"></i>Избранное</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><div id="favorites-list" class="row g-4"></div><div id="no-favorites" class="text-center text-muted py-5 d-none"><i class="far fa-heart fa-3x mb-3"></i><p>У вас нет сохранённых товаров.</p></div></div></div></div></div>
    <!-- Cart / Checkout Modal -->
    <div class="modal fade" id="cartModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content" id="cartModalContent">
                <!-- Содержимое будет генерироваться JS -->
            </div>
        </div>
    </div>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/aos/2.3.4/aos.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-j1CDi7MgGQ12Z7Qab0qlWQ/Qqz24Gc6BM0thvEMVjHnfYGF0rmFCozFSxQBxwHKO"
            crossorigin="anonymous"></script>
    <script src="~/js/site.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
